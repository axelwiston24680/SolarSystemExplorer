<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D28">

    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚀  SOLAR SYSTEM EXPLORER"
                android:textColor="#FFE08A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="5dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A little universe of big discoveries!"
                android:textColor="#C8D5FF"
                android:textSize="15sp"
                android:gravity="center"
                android:paddingBottom="12dp" />
            <com.axelwiston.solarsystemexplorer.PlanetView
                android:id="@+id/planetView"
                android:layout_width="match_parent"
                android:layout_height="270dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👆 Tap a planet for a fact • Double-tap to explore and rotate"
                android:textColor="#FFE08A"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#172044"
                android:padding="18dp">
                <TextView
                    android:id="@+id/planetName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="☀️ The Sun"
                    android:textColor="#FFE08A"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/planetFact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:lineSpacingExtra="5dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp" />
                <TextView
                    android:id="@+id/planetExtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#BFD0FF"
                    android:textSize="14sp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌟  SPACE QUIZ"
                android:textColor="#FFE08A"
                android:textSize="21sp"
                android:textStyle="bold"
                android:paddingTop="22dp"
                android:paddingBottom="8dp" />
            <TextView
                android:id="@+id/quizQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="8dp" />
            <LinearLayout
                android:id="@+id/answers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/quizFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFE08A"
                android:textSize="15sp"
                android:padding="10dp" />
            <Button
                android:id="@+id/nextQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Next question ➜"
                android:backgroundTint="#FFCA5C"
                android:textColor="#182044"
                android:layout_marginBottom="24dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/detailScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#090D28"
        android:visibility="gone">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.axelwiston.solarsystemexplorer.PlanetView
                android:id="@+id/detailPlanetView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:padding="16dp"
                android:textColor="#FFE08A"
                android:textSize="25sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/closeDetail"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:background="#55334466"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Close planet details" />
        </FrameLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:background="#172044">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:id="@+id/detailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:lineSpacingExtra="5dp" />
                <TextView
                    android:id="@+id/detailFunFact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:textColor="#FFE08A"
                    android:textSize="15sp" />
                <TextView android:id="@+id/detailWorldInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:text="Tap a highlighted feature to explore this world." android:textColor="#FFE08A" android:textSize="15sp"/>
                <TextView
                    android:id="@+id/detailDiscovery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:textColor="#BFD0FF"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>