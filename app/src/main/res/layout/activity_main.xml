<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D28"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀  SOLAR SYSTEM EXPLORER"
            android:textColor="#FFE08A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="5dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A little universe of big discoveries!"
            android:textColor="#C8D5FF"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingBottom="12dp" />
        <com.axelwiston.solarsystemexplorer.PlanetView
            android:id="@+id/planetView"
            android:layout_width="match_parent"
            android:layout_height="270dp" />
        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👆 Tap a planet to explore it!"
            android:textColor="#FFE08A"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="8dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#172044"
            android:padding="18dp">
            <TextView
                android:id="@+id/planetName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☀️ The Sun"
                android:textColor="#FFE08A"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/planetFact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The Sun is a star. It gives our solar system light and heat!"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:lineSpacingExtra="5dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp" />
            <TextView
                android:id="@+id/planetExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fun fact: The Sun is at the center of our solar system."
                android:textColor="#BFD0FF"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌟  SPACE QUIZ"
            android:textColor="#FFE08A"
            android:textSize="21sp"
            android:textStyle="bold"
            android:paddingTop="22dp"
            android:paddingBottom="8dp" />
        <TextView
            android:id="@+id/quizQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Which planet is known as the Red Planet?"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="8dp" />
        <LinearLayout
            android:id="@+id/answers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView
            android:id="@+id/quizFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose an answer to begin!"
            android:textColor="#FFE08A"
            android:textSize="15sp"
            android:padding="10dp" />
        <Button
            android:id="@+id/nextQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Next question ➜"
            android:backgroundTint="#FFCA5C"
            android:textColor="#182044"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
